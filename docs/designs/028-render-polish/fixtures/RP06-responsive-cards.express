$/note = ""
root = Column(children=[MarkdownView(text="# 当前任务：跨团队验证与待确认事项"),Text(text="固定响应式样例 · 允许标题换行，保留完整说明",variant="caption"),Row(children=[Card(child=Column(children=[Text(text="计划内任务",variant="caption"),MarkdownView(text="## 12"),Text(text="完整数据来自固定fixture，不代表当前Pi进度。",variant="caption")])),Card(child=Column(children=[Text(text="需要确认",variant="caption"),MarkdownView(text="## 3"),Text(text="没有确认就不执行，这里只显示下一步说明。",variant="caption")])),Card(child=Column(children=[Text(text="未开始",variant="caption"),MarkdownView(text="## 4"),Text(text="没有原生事件证据，不显示虚构完成百分比。",variant="caption")]))]),Card(child=Column(children=[MarkdownView(text="### 留下审阅备注"),TextField(label="备注（草稿不应被样式切换清空）",value=$/note),Button(child=Text(text="等待确认"),action=Event("collect_note",{note:$/note}))]))])
