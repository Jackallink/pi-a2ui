root = Card(child=Column(children=[MarkdownView(text="# 空、加载与错误状态"),Text(text="全部为固定状态样例，非实时业务结果",variant="caption"),StatusBadge(label="等待人工确认",status="info"),DataTable(caption="暂无记录",columns=[{id:"name",label:"名称"}],rows=[],state="ready",message="当前没有可显示的记录。"),DataTable(caption="正在准备数据",columns=[{id:"name",label:"名称"}],rows=[],state="loading",message="固定加载样例，不代表实际请求。"),StatusBadge(label="数据尚未获取",status="error"),DataTable(caption="数据获取失败",columns=[{id:"name",label:"名称"}],rows=[],state="error",message="固定错误样例。请先核对数据来源，不自动重试。"),Details(title="错误详情",child=CodeBlock(code="FIXTURE_SOURCE_UNAVAILABLE\nThis is an illustrative state, not a real network failure.",language="text")),Modal(trigger=Text(text="查看使用说明"),content=Text(text="本地说明弹窗，关闭后焦点应回到入口，不触发Pi动作。"))]))
