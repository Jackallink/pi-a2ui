{
  "name": "pi-a2ui",
  "version": "0.1.3",
  "description": "A local A2UI canvas for the Pi coding agent",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extension.ts"
    ]
  },
  "files": [
    "extension.ts",
    "src/",
    "dist/",
    "README.md",
    "THIRD_PARTY_LICENSES.txt",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test:browser": "playwright test tests/browser.spec.ts --workers=1"
  },
  "dependencies": {
    "@a2ui/agent": "0.1.0",
    "@a2ui/lit": "0.15.0",
    "@a2ui/web_core": "0.15.0",
    "lit": "3.3.3",
    "zod": "3.25.76"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.5.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.19.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typebox": "1.3.27"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jackallink/pi-a2ui.git"
  },
  "homepage": "https://github.com/Jackallink/pi-a2ui#readme",
  "bugs": {
    "url": "https://github.com/Jackallink/pi-a2ui/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "a2ui",
    "coding-agent",
    "generative-ui"
  ]
}
